# Project root .env (template). The REAL .env is created manually on the server and is git-ignored.
# Both the app and backend/migrate.cjs read this file.

# --- APP ---
PORT=3001
NODE_ENV=production

# Public subpath the SPA is served under. Must match frontend/vite.config.ts `base`.
# Also scopes the session cookie so a neighbouring app on the same domain cannot read it.
BASE_PATH=/programs/moj-pcelinjak/

# Uploads are resolved relative to the project root. The backup script reads the same value.
UPLOAD_DIR=uploads

# --- AUTH ---
# Signs session JWTs. Generate with: openssl rand -base64 48
# Changing it invalidates every active session (everyone is logged out).
JWT_SECRET=replace-with-a-long-random-string
# Days a session stays valid without re-login.
SESSION_DAYS=30

# --- AI SLOJ (§13, §18, §31, §39, §44-§46) ---
# Both keys are OPTIONAL. Without them the application runs exactly as it did before this stage:
# the AI screens report themselves unavailable and every register, form and report is untouched.
# Nothing here is a dependency of recording an inspection.
#
# Anthropic — the assistant, the daily summary, and reading photographs. Create at
# console.anthropic.com. Model and prices are in backend/src/lib/ai.ts; the SPEND CAP is not here,
# it is administrable at /admin (default 5 € per farm per month).
ANTHROPIC_API_KEY=

# Groq — speech to text for voice entry only (whisper-large-v3). Create at console.groq.com.
# Leave empty to keep everything else working with the microphone button hidden.
GROQ_API_KEY=
# Swap the transcription provider without touching a route; only 'groq' is implemented today.
# The seam is backend/src/lib/voice.ts.
STT_PROVIDER=groq

# --- MySQL / MariaDB (aaPanel, same server) ---
# PREFERRED: discrete vars — no URL-encoding pain with # @ ! in aaPanel passwords.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moj_pcelinjak_db
DB_USER=moj_pcelinjak_user
DB_PASSWORD=replace-with-strong-password

# ALTERNATIVE to the DB_* block above: a single connection URL.
# The code prefers DB_* when set; otherwise it parses DATABASE_URL.
# DATABASE_URL=mysql://moj_pcelinjak_user:password@127.0.0.1:3306/moj_pcelinjak_db
