# Dependencies
node_modules/
jspm_packages/

# Environment files — NEVER commit real secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local database data (if you run a containerized DB locally)
pgdata/
mysqldata/

# User uploads — NEVER commit. Holds scanned rješenja, laboratory findings and hive photos, which
# carry an OIB, a home address and apiary surroundings (§56). This repository is public.
uploads/
*.sql.gz
*.dump

# Browser automation artefacts from local verification runs.
.playwright-mcp/
test-results/

# Screenshots land in the project root when Playwright is given a relative path, and they show
# whatever was on screen — an OIB, a home address, apiary names. This repository is public.
#
# Anchored with a leading slash so it covers only the root: a blanket *.png would also swallow
# frontend/public/pwa-*.png and src/assets/hero.png, which are real assets the build needs.
/*.png
/*.jpg
/*.jpeg
/*.webp

# OS metadata
.DS_Store
Thumbs.db
